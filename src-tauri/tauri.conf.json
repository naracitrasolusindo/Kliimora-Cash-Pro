{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kliimora Cash Pro",
  "version": "2.1.0",
  "identifier": "com.kliimora.cashpro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kliimora Cash Pro",
        "width": 1000,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/naracitrasolusindo/Kliimora-Cash-Pro/releases/latest/download/latest.json"
      ],
